{
  "name": "@oneintern/web",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "dev": "vite preview --host 127.0.0.1 --port 4500",
